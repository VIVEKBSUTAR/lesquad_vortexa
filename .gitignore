# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# next.js
/.next/
/out/

# production
/build
dist/

# misc & OS
.DS_Store
Thumbs.db
desktop.ini
*.pem
*.swp
*.swo
*~

# debug & logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log
logs/

# env files (never commit real .env files with secrets)
.env
.env.*
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
gsap-public/

# Python & Backend Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
*.egg-info/
.installed.cfg
*.egg

# Database files
*.sqlite
*.sqlite3
*.db
